# SkillProof Backend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git.

PORT=3001
NODE_ENV=development
JWT_SECRET=your_strong_jwt_secret_here_change_in_production

# MongoDB Atlas
# 1. Go to https://cloud.mongodb.com
# 2. Click your cluster > Connect > Drivers
# 3. Copy the connection string and replace <db_password>
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/fsdproject?retryWrites=true&w=majority

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub OAuth (Phase 6)
# 1. Go to https://github.com/settings/developers > New OAuth App
# 2. Set Homepage URL: http://localhost:5173
# 3. Set Callback URL: http://localhost:3001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# Twilio SMS (Phase 8)
# 1. Sign up at https://www.twilio.com
# 2. Get Account SID, Auth Token, and a Twilio phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Gemini AI (AI Resume Analyzer, Interview Q&A, and Skill Matching)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
